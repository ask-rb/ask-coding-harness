# Askoda Server Configuration

# Coding provider — ACP is recommended (works with Codex, Claude, OpenCode, ZCode via bridges)
# CODING_PROVIDER=acp
# ACP_COMMAND=codex acp

# Legacy providers (deprecated, prefer ACP):
CODING_PROVIDER=acp

# AskAgent provider settings (for CODING_PROVIDER=ask_agent)
# ASK_AGENT_MODEL=deepseek-v4-flash
# ASK_AGENT_LLM_PROVIDER=opencode_go
# OPENCODE_API_KEY=sk-your-key-here

# Server
PORT=8080
HOST=0.0.0.0
ASKODA_DB_PATH=data/askoda.db
TURN_TIMEOUT=300
