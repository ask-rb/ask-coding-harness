# ask-coding-harness environment (copy to .env — the harness reads the
# environment directly; the ask-auth chain also reads ~/.ask/credentials.yml)

# Workspace the agent operates on
# ACH_WORKSPACE=/path/to/project

# Model + provider key (ask-llm-providers openai-compatible registry)
# ACH_MODEL=deepseek-v4-flash
# OPENCODE_API_KEY=sk-...

# Server
# ACH_HOST=0.0.0.0
# ACH_PORT=8080

# Agent behavior
# ACH_APPROVAL=require        # off | require | auto
# ACH_PLAN_MODE=0             # 1 to enable plan mode
# ACH_TODOS=1
# ACH_MAX_TURNS=25

# Adapter: ask_agent (default), demo (no keys), acp, codex, claude
# ACH_ADAPTER=ask_agent

# Storage
# ACH_DB_PATH=./data/ask-coding-harness.db
