#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# Build the web frontend if stale (no auto-watch, just build once)
if [ ! -f public/index.html ] || [ "web/src" -nt "public/index.html" ] 2>/dev/null; then
  echo "📦 Building frontend..."
  (cd web && npm run build --silent 2>/dev/null)
fi

mkdir -p api/data

echo "🚀 Askoda — http://localhost:${PORT:-8080}  (auto-reload on file changes)"
bundle exec rackup config.ru -p ${PORT:-8080} -o ${HOST:-0.0.0.0}
