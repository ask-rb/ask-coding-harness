#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "rack"
require "rackup"
require "askoda/server"

port = (ENV["PORT"] || 8080).to_i
host = ENV["HOST"] || "0.0.0.0"

puts "🚀 Askoda server starting..."
puts "   Port: #{host}:#{port}"
puts "   Provider: #{ENV.fetch("CODING_PROVIDER", "acp")}"
puts "   DB: #{Askoda::Server::DB_PATH}"
puts "   Open: http://localhost:#{port}"

app = Askoda::Server.freeze.app
Rackup::Server.start(
  app: app,
  Port: port,
  Host: host,
  server: "puma"
)
